    "sidebar-width": "248px",
    "sidebar-collapsed-width": "72px",
    "header-height": "72px",
    "page-max-width": "1440px",
    "gutter-mobile": "16px",
    "gutter-tablet": "24px",
    "gutter-desktop": "36px",
    "card-padding": "24px",
    "control-height-sm": "32px",
    "control-height-md": "40px",
    "control-height-lg": "48px"
