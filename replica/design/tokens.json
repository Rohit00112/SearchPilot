  "breakpoints": {
    "xs": "480px",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px",
    "wide": "1720px"
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "280ms",
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "ease-emphasized": "cubic-bezier(0.16, 1, 0.3, 1)",
    "reduce": "0.01ms"
  },
  "componentStates": {
    "button": {
      "primary": "accent / on-accent",
      "hover": "accent-hover / on-accent",
      "active": "accent-active / on-accent",
      "secondary": "surface / text + border",
      "disabled": "disabled-bg / disabled-text",
      "focus": "focus outline 3px"
    },
    "input": {
      "default": "surface / text + border-input",
      "focus": "focus ring on surface",
      "error": "danger border + danger-soft supporting text",
      "disabled": "disabled-bg / disabled-text"
    },
    "navigation": {
      "sidebar": "sidebar / text-muted",
      "selected": "accent-soft / text-accent",
      "topbar": "header / text-inverse"
    },
    "kpi": {
      "default": "surface / text",
      "provenance": "text-muted + source and updated timestamp",
      "synthetic": "always label sample",
      "positive": "success",
      "negative": "danger"
    },
    "issue": {
      "error": "danger-soft / danger",
      "warning": "warning-soft / warning",
      "passing": "success-soft / success"
    },
    "report": {
      "card": "surface / text + shadow-card",
      "loading": "surface-muted skeleton with reduced motion",
      "empty": "surface / text-muted"
    }
  }
