{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_about": "SearchPilot original brand and UI design tokens, derived from functional patterns in public documentation. Values are SearchPilot-specific, never copied from Semrush. Run python3 replica/design/contrast.py replica/design/tokens.json --write-css replica/design/tokens.css --report replica/design/contrast-report.md",
  "brand": {
    "name": "SearchPilot",
    "theme": "Ocean signal",
    "intent": "Trustworthy technical clarity: deep Atlantic navigation, signal-teal actions, cool linen surfaces, disciplined typography.",
    "font_license": "Prefer freely available Inter (SIL OFL) or the operating-system sans stack; do not bundle proprietary fonts.",
    "icon_style": "Lucide or original line icons with 1.75px stroke; never reuse vendor illustrations, logos or screenshots."
  },
  "color": {
    "bg": "#F5F8F8",
    "surface": "#FFFFFF",
    "surface-muted": "#EAF2F3",
    "surface-raised": "#FAFCFC",
    "surface-inset": "#E0EAEC",
    "sidebar": "#F9FBFB",
    "header": "#102E38",
    "header-hover": "#21414B",
    "border": "#CAD8DC",
    "border-input": "#748991",
    "border-strong": "#657F88",
    "text": "#142F38",
    "text-muted": "#50646E",
    "text-subtle": "#596F79",
    "text-inverse": "#FFFFFF",
    "text-inverse-muted": "#D2E2E6",
    "accent": "#006B73",
    "accent-hover": "#00565E",
    "accent-active": "#00464D",
    "accent-soft": "#D9F0EF",
    "on-accent": "#FFFFFF",
    "text-accent": "#005860",
    "danger": "#A02D3D",
    "danger-hover": "#81202F",
    "danger-soft": "#FCEAEC",
    "on-danger": "#FFFFFF",
    "success": "#17684D",
    "success-soft": "#DFF4E8",
    "warning": "#845613",
    "warning-soft": "#FFF0D3",
    "info": "#245B91",
    "info-soft": "#E5F0FC",
    "focus": "#08737B",
    "disabled-bg": "#E5ECEE",
    "disabled-text": "#506770",
    "chart-1": "#007D83",
    "chart-2": "#2E628D",
    "chart-3": "#B46B39",
    "chart-4": "#7B518D",
    "chart-5": "#327A59",
    "chart-grid": "#CDDCDF",
    "chart-label": "#51646D"
  },
  "pairs": [
    ["text","bg"], ["text","surface"], ["text","surface-muted"], ["text","surface-raised"], ["text","sidebar"],
    ["text-muted","bg"], ["text-muted","surface"], ["text-muted","surface-muted"], ["text-muted","surface-raised"], ["text-muted","sidebar"],
    ["text-subtle","bg"], ["text-subtle","surface"], ["text-subtle","surface-muted"],
    ["text-inverse","header"], ["text-inverse-muted","header"], ["text-inverse","header-hover"],
    ["on-accent","accent"], ["on-accent","accent-hover"], ["on-accent","accent-active"],
    ["text-accent","bg"], ["text-accent","surface"], ["text-accent","accent-soft"],
    ["on-danger","danger"], ["on-danger","danger-hover"], ["danger","surface"], ["danger","danger-soft"],
    ["success","surface"], ["success","success-soft"], ["warning","surface"], ["warning","warning-soft"],
    ["info","surface"], ["info","info-soft"], ["disabled-text","disabled-bg"],
    ["chart-label","surface"], ["chart-label","bg"],
    ["border-input","surface","ui"], ["border-input","bg","ui"], ["border-strong","surface","ui"],
    ["focus","surface","ui"], ["focus","bg","ui"], ["accent","surface","ui"],
    ["danger","surface","ui"], ["success","surface","ui"], ["warning","surface","ui"],
    ["chart-1","surface","ui"], ["chart-2","surface","ui"], ["chart-3","surface","ui"], ["chart-4","surface","ui"], ["chart-5","surface","ui"]
  ],
  "font": {
    "sans": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Consolas, monospace"
  },
  "type": {
    "eyebrow": {"size": 11, "line": 16, "weight": 700, "tracking": "0.08em"},
    "xs": {"size": 12, "line": 18, "weight": 500, "tracking": "0"},
    "sm": {"size": 14, "line": 21, "weight": 400, "tracking": "0"},
    "base": {"size": 16, "line": 24, "weight": 400, "tracking": "0"},
    "lg": {"size": 18, "line": 26, "weight": 600, "tracking": "-0.01em"},
    "xl": {"size": 22, "line": 30, "weight": 650, "tracking": "-0.02em"},
    "page": {"size": 30, "line": 38, "weight": 750, "tracking": "-0.03em"},
    "metric": {"size": 34, "line": 42, "weight": 750, "tracking": "-0.04em"},
    "display": {"size": 42, "line": 50, "weight": 750, "tracking": "-0.04em"}
  },
  "space": {
    "0": 0, "px": 1, "0.5": 2, "1": 4, "1.5": 6,
    "2": 8, "3": 12, "4": 16, "5": 20, "6": 24,
    "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96
  },
  "radius": {"xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 22, "pill": 999},
  "shadow": {
    "card": "0 1px 3px rgba(16, 46, 56, 0.06), 0 9px 24px rgba(16, 46, 56, 0.035)",
    "hover": "0 4px 12px rgba(16, 46, 56, 0.10), 0 16px 32px rgba(16, 46, 56, 0.045)",
    "popover": "0 16px 40px rgba(16, 46, 56, 0.18)",
    "focus": "0 0 0 3px rgba(8, 115, 123, 0.25)"
  },
  "layout": {
    "sidebar-width": "248px",
    "sidebar-collapsed-width": "72px",
    "header-height": "72px",
    "page-max-width": "1440px",
    "gutter-mobile": "16px",
    "gutter-tablet": "24px",
    "gutter-desktop": "36px",
    "card-padding": "24px",
    "control-height-sm": "32px",
    "control-height-md": "40px",
    "control-height-lg": "48px"
  },
  "breakpoints": {
    "xs": "480px",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px",
    "wide": "1720px"
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "280ms",
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "ease-emphasized": "cubic-bezier(0.16, 1, 0.3, 1)",
    "reduce": "0.01ms"
  },
  "componentStates": {
    "button": {"primary": "accent / on-accent", "hover": "accent-hover / on-accent", "active": "accent-active / on-accent", "secondary": "surface / text + border", "disabled": "disabled-bg / disabled-text", "focus": "focus outline 3px"},
    "input": {"default": "surface / text + border-input", "focus": "focus ring on surface", "error": "danger border + danger-soft supporting text", "disabled": "disabled-bg / disabled-text"},
    "navigation": {"sidebar": "sidebar / text-muted", "selected": "accent-soft / text-accent", "topbar": "header / text-inverse"},
    "kpi": {"default": "surface / text", "provenance": "text-muted + source and updated timestamp", "synthetic": "always label sample", "positive": "success", "negative": "danger"},
    "issue": {"error": "danger-soft / danger", "warning": "warning-soft / warning", "passing": "success-soft / success"},
    "report": {"card": "surface / text + shadow-card", "loading": "surface-muted skeleton with reduced motion", "empty": "surface / text-muted"}
  }
}
