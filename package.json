    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "tsc --noEmit",
        "db:status": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-migrate.mjs status",
