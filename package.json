        "recharts": "^2.15.4"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.64.0",
        "@types/node": "^22.18.0",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "autoprefixer": "^10.4.21",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.9.2"
    }
}
